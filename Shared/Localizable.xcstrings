    "%@ had none. One short session there would even out the week." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Am %@ gab es keine. Eine kurze Sitzung dort gleicht die Woche aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ninguna el %@. Una sesión corta ese día equilibraría la semana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n’en a eu aucune. Une courte session ce jour-là équilibrerait la semaine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@は集中ゼロでした。その日に短いセッションを1回入れると、週のバランスが整います。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ficou sem nenhuma. Uma sessão curta ali equilibraria a semana."
          }
        }
      }
    },
