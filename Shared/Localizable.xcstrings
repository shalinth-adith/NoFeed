        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma semana mais leve que a anterior. Ainda conta."
          }
        }
      }
    },
    "A name and an icon is all it takes" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
