    "Some days that’s what there is. %@ still count — nothing about today is broken." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manche Tage sind eben so. %@ — das zählt. An heute ist nichts verkehrt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hay días así. %@ también cuentan — nada de hoy está roto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certains jours, c’est ce qu’il y a. %@, ça compte quand même — rien n’est cassé aujourd’hui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "そんな日もあります。%@でも、ちゃんと記録に残ります。今日がだめになったわけではありません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
