    "Without Screen Time access NoFeed can time a session but can’t block anything. You can grant it now, or later from Settings." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohne Bildschirmzeit-Zugriff kann NoFeed eine Sitzung zwar timen, aber nichts blockieren. Du kannst ihn jetzt erlauben oder später in den Einstellungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin acceso a Tiempo de uso, NoFeed puede cronometrar una sesión, pero no bloquear nada. Puedes darlo ahora o más tarde desde Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sans l’accès à Temps d’écran, NoFeed peut chronométrer une session mais ne peut rien bloquer. Tu peux l’autoriser maintenant, ou plus tard dans Réglages."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スクリーンタイムへのアクセスがないと、NoFeedはセッションの時間を計れますが、何もブロックできません。今すぐ許可することも、あとで設定から許可することもできます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem acesso ao Tempo de Uso, o NoFeed consegue cronometrar uma sessão, mas não bloqueia nada. Você pode permitir agora ou depois em Ajustes."
          }
        }
      }
    },
