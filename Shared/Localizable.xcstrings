    "Allowed apps are never blocked. Most people allow a messaging app, so someone important can still reach them." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaubte Apps werden nie blockiert. Viele erlauben eine Messaging-App, damit wichtige Menschen sie weiter erreichen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las apps permitidas nunca se bloquean. Mucha gente permite una app de mensajería para que alguien importante pueda localizarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les apps autorisées ne sont jamais bloquées. La plupart des gens autorisent une messagerie, pour qu’une personne importante puisse toujours les joindre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "許可したアプリはブロックされません。大切な人から連絡が届くよう、メッセージアプリを許可する人が多いです。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apps permitidos nunca são bloqueados. A maioria das pessoas permite um app de mensagens, para que alguém importante ainda consiga falar com elas."
          }
        }
      }
    },
