    "NoFeed uses Apple's Screen Time to block distracting apps during focus. Your activity stays private on your device — NoFeed never sees it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NoFeed nutzt Apples Bildschirmzeit, um ablenkende Apps während des Fokus zu blockieren. Deine Aktivität bleibt privat auf deinem Gerät — NoFeed sieht sie nie."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NoFeed usa Tiempo de uso de Apple para bloquear apps que distraen durante la concentración. Tu actividad se queda privada en tu dispositivo — NoFeed nunca la ve."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NoFeed utilise Temps d’écran d’Apple pour bloquer les apps qui distraient pendant la concentration. Ton activité reste privée sur ton appareil — NoFeed ne la voit jamais."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NoFeedはAppleのスクリーンタイムを使って、集中中に気が散るアプリをブロックします。アクティビティはデバイス内に保持され、NoFeedが見ることはありません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O NoFeed usa o Tempo de Uso da Apple para bloquear apps que distraem durante o foco. Sua atividade fica privada no seu dispositivo — o NoFeed nunca a vê."
          }
        }
      }
    },
